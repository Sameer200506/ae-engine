# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL. Used for Stripe redirects, share links and the widget snippet.
# Local dev: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies AND widget share tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-hex-string

# Where the SQLite file lives. Created automatically on first run.
DATABASE_PATH=./data/app.db

# ---------------------------------------------------------------------------
# LLM (chat) — OpenRouter, whose free models need no credit card
# ---------------------------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models. The ":free" suffix means $0.
# Good, reliable free picks (checked Sep 2026):
#   deepseek/deepseek-v4-flash-0731:free   1M ctx, fast
#   nvidia/nemotron-3-super-120b-a12b:free 262K ctx, very reliable
#   cohere/north-mini-code:free            256K ctx, lowest latency
#   openrouter/free                        auto-router: picks an available free model
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Comma-separated. Tried in order when the primary model errors or rate-limits.
# Free endpoints hit upstream 429s often, so a fallback chain matters.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free

# Optional: sent as HTTP-Referer / X-Title so OpenRouter attributes your traffic.
OPENROUTER_SITE_NAME=AEO Engine

# Optional overrides to point at any other OpenAI-compatible provider
# (OpenAI, Groq, DeepSeek, Together) or a local Ollama/LM Studio server.
# Leave blank to use OpenRouter.
#
# To demo the whole app with no API key at all, run `npm run mock:llm` and set:
#   LLM_BASE_URL=http://localhost:8787/v1
#   LLM_API_KEY=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Embeddings (for the knowledge base / RAG)
# ---------------------------------------------------------------------------
# EMBEDDINGS_PROVIDER = openrouter | openai | none
#   openrouter -> free embedding models, no extra cost (default)
#   openai     -> text-embedding-3-small, costs money, most reliable
#   none       -> disables knowledge-base indexing (chat still works)
EMBEDDINGS_PROVIDER=openrouter

# Free embedding models on OpenRouter (checked Sep 2026):
#   nvidia/nemotron-3-embed-1b:free
#   liquid/lfm-2.5-embedding-350m:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Only needed when EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Stripe (test mode is fine) — leave blank to run without billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Optional second paid tier
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Comma-separated emails auto-promoted to admin on signup.
# The very first account created is always made an admin.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Limits (free plan) — override without touching code
# ---------------------------------------------------------------------------
FREE_MONTHLY_MESSAGES=25
FREE_MAX_AGENTS=1
FREE_MAX_DOCUMENTS=3
